{
  "schema": "outlaw.animation-parts-manifest",
  "schema_version": "2.0",
  "purpose": "Give Claude the part files, estimated pivots, parent hierarchy, draw order and underpaint rules needed to build a cutout rig.",
  "is_spine_import_or_runtime_json": false,
  "read_first": "This is a rigging instruction manifest, not an automatically importable Spine skeleton. Assemble and visually align sprites first. Do not animate the complete atlas or the original reference as one image.",
  "status": "AI-reconstructed cutout art with painted joint extensions. Not a production-validated rig.",
  "art_fidelity": "Derived from the provided character. AI reconstructed hidden surfaces and may have reinterpreted visible details; this is not a pixel-identical source extraction.",
  "original_reference": "Original_Reference.png",
  "coordinate_system": {
    "units": "pixels",
    "origin": "top_left",
    "x_positive": "right",
    "y_positive": "down",
    "original_reference_canvas": [
      1060,
      1584
    ]
  },
  "default_root": {
    "id": "root",
    "pivot_canvas_xy": [
      530,
      1550
    ],
    "lock_translation_for_idle": true,
    "lock_scale": true
  },
  "assembly_workflow": [
    "Load individual transparent PNGs from parts/. The original reference is a positioning guide only.",
    "Use estimated_setup as an initial guide. Uniformly resize and visually align each part to the reference; do not assume these estimated coordinates already produce an approved pose.",
    "Create bones in parent-first topological order. Slot draw order is independent of bone order.",
    "Use pivot_local_xy for each sprite rotation. After setup, keep body/gun scale constant. Setup uniform scale is only for aligning generated art.",
    "Round joint plugs and hidden extensions go underneath neighbouring art; never align cut edges flush.",
    "Use overlap_pairs to place and mask joint seams. Adjust slot draw order locally where sleeves, collar or boots must cover their joint plugs.",
    "Choose poncho_shoulder and poncho_front coverage deliberately: these reconstruct some of the same folds. Mask hidden duplicate fabric after alignment rather than draw repeated folds visibly.",
    "Keep hatband_optional disabled unless replacing the band baked into the hat.",
    "Review every seam at neutral and at maximum rotation before generating final animation.",
    "Then create a Spine JSON skeleton and pack an atlas for the exact Spine/runtime version used by the team."
  ],
  "animation_rules": [
    "Animate separate parts using bone rotation/translation. Never apply one global mesh to the complete character.",
    "Do not stretch or squeeze the face, limbs, hands, boots, hat or revolver. No animated nonuniform scaling or shear.",
    "Gun barrel must remain rigid; the hand and gun move together unless a deliberate independent action is requested.",
    "Use shoulder/elbow/wrist and hip/knee/ankle chains, with anatomically sensible pivots.",
    "Only the poncho may use gentle mesh deformation and staggered follow-through.",
    "For idle, pin both feet and keep the root still. Keep the character registration stable.",
    "Use 30 FPS. For a 1.5-second symbol win, use 45 frame intervals and neutral first/end poses when a loop is requested.",
    "Use eased timing and overlapping action, not synchronized wobble.",
    "If a gap appears, increase real painted overlap or correct layer order. Never hide it by stretching a body part.",
    "Generated overlap does not guarantee arbitrary turns or large pose changes; paint additional hidden anatomy if a requested action reveals unsupported areas."
  ],
